From: cf <cf@example.com>
Date: Fri, 16 Oct 2026 11:19:44 +0200
Subject: [PATCH] Relax the dependency pins to what conda-forge ships.

* setuptools, wheel, cffi, cython and pkgconfig are only needed to build the
  pinned dependencies from source, which conda does not do. Nothing in
  onionshare_cli imports them.
* stem is pinned to exactly 1.8.1 upstream; allow newer patch releases.
---
 pyproject.toml | 7 +------
 1 file changed, 1 insertion(+), 6 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 5a5d4b2..f06b13b 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -32,20 +32,15 @@ dependencies = [
     "unidecode",
     "urllib3 >= 2.7, < 3.0",
     "eventlet",
-    "setuptools >= 83",
     "pynacl >= 1.6.2, < 2.0",
     "colorama",
     "gevent-websocket",
-    "stem == 1.8.1",
+    "stem >= 1.8.1",
     "waitress >= 3.0.1, < 4.0.0",
     "werkzeug == 3.1.9",
     "packaging >= 24",
     "gevent >= 26.5.0, < 27.0.0",
-    "wheel >= 0.46.2, < 1.0",
-    "cffi >= 2, < 3",
-    "cython >= 3.0.2, < 4.0",
     "qrcode >= 7.4.2, < 8.0.0",
-    "pkgconfig >= 1.6.0, < 2.0",
 ]
 
 [project.urls]
